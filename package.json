{
  "name": "dry-ai",
  "version": "1.0.2",
  "description": "CLI for syncing shared AI commands, rules, and skills into supported agent targets.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/willmruzek/dry-ai.git"
  },
  "license": "MIT",
  "files": [
    "dest/**/*.js",
    "dest/**/*.d.ts"
  ],
  "scripts": {
    "setup:editor": "effect-language-service patch",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "dev:dry-ai": "node ./dest/main.js",
    "fmt": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tsc": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "bin": {
    "dry-ai": "dest/main.js"
  },
  "dependencies": {
    "@effect/cli": "^0.75.1",
    "@effect/cluster": "^0.58.2",
    "@effect/experimental": "^0.60.0",
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.106.0",
    "@effect/rpc": "^0.75.1",
    "@effect/sql": "^0.51.1",
    "@effect/workflow": "^0.18.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dedent": "^1.7.2",
    "effect": "^3.21.2",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "package-directory": "^8.2.0",
    "simple-git": "^3.35.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^6.5.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@effect/language-service": "^0.85.0",
    "@effect/vitest": "^0.29.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.4",
    "@willmruzek/my-toolkit": "github:willmruzek/my-toolkit#0aee28204348e5b5eee0dbc55a2f4aaeede766cc",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "immer": "^10.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*": "prettier --write --ignore-unknown"
  }
}
